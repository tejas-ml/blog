---
import { postPath, formatDate, type Post } from "../lib/posts";
import SectionBadge from "./SectionBadge.astro";

interface Props {
  posts: Post[];
  showSection?: boolean;
}
const { posts, showSection = true } = Astro.props;
const base = import.meta.env.BASE_URL;

function tagSlug(tag: string) {
  return tag.toLowerCase().replace(/\s+/g, "-");
}
---
{posts.length === 0 ? (
  <p class="page-intro">No posts in this section yet.</p>
) : (
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-item">
        <div class="meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {showSection && <SectionBadge slug={post.data.category} />}
        </div>
        <a class="title" href={postPath(post)}>{post.data.title}</a>
        <p>{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((tag) => (
              <a class="tag" href={`${base}tags/${tagSlug(tag)}/`}>{tag}</a>
            ))}
          </div>
        )}
      </li>
    ))}
  </ul>
)}
