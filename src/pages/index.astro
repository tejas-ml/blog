---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { getPublishedPosts } from "../lib/posts";
import { SECTIONS, sectionPath } from "../lib/sections";

const posts = await getPublishedPosts();
const description =
  "Technical notes by Tejas Mahajan, a PhD student in Computer Science at the UCF Computational Biology Lab, on biology, chemistry, industry biochem, computer architecture, quant trading, and AI.";
---
<Base
  title="Tejas Mahajan — Blog"
  description={description}
  current="home"
  canonical="https://tejas-ml.github.io/blog/"
>
  <main>
    <p class="page-kicker">Blog</p>
    <h1 class="page-title">Notes on methods and systems</h1>
    <p class="page-intro">
      I write about biology, chemistry, industry applications of biochem, computer architecture,
      quantitative trading, and machine learning. I am a PhD student in Computer Science at the
      <a href="https://www.cs.ucf.edu/compbio/">UCF Computational Biology Lab</a>.
      This is the writing companion to my
      <a href="https://tejas-ml.github.io/">portfolio</a>.
    </p>
    <div class="tags" style="margin: -16px 0 36px;">
      {SECTIONS.map((section) => (
        <a class="section-badge" href={sectionPath(section.slug)}>{section.title}</a>
      ))}
    </div>

    <PostList posts={posts} showSection={true} />
  </main>
</Base>
