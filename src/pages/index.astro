---
import Base from "../layouts/Base.astro";
import { getPublishedPosts, postPath, formatDate } from "../lib/posts";

const posts = await getPublishedPosts();
const description =
  "Technical notes by Tejas Mahajan, a PhD student in Computer Science at the UCF Computational Biology Lab, on machine learning, AI security, computational biology, and systems.";
---
<Base
  title="Tejas Mahajan — Blog"
  description={description}
  current="home"
  canonical="https://tejas-ml.github.io/blog/"
>
  <main>
    <p class="page-kicker">Blog</p>
    <h1 class="page-title">Notes on methods and systems</h1>
    <p class="page-intro">
      I write about machine learning, AI security, computational biology, and computer systems.
      I am a PhD student in Computer Science at the
      <a href="https://www.cs.ucf.edu/compbio/">UCF Computational Biology Lab</a>.
      This is the writing companion to my
      <a href="https://tejas-ml.github.io/">portfolio</a>.
    </p>

    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <div class="meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          </div>
          <a class="title" href={postPath(post)}>{post.data.title}</a>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((tag) => (
                <a class="tag" href={`${import.meta.env.BASE_URL}tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`}>{tag}</a>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  </main>
</Base>
